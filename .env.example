# ==============================================================================
# RepoLens Environment Configuration Template
# Copy this file to .env and adjust variables as required
# ==============================================================================

# GitHub Personal Access Token (Optional)
# Unauthenticated requests are limited to 60 req/hour by GitHub.
# Providing a personal access token raises the limit to 5,000 req/hour.
GITHUB_TOKEN=

# LLM Configuration (Optional)
# Leave empty to use intelligent template-based generation (zero API keys required).
# Setting OPENAI_API_KEY activates LLM-powered summaries.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cache Settings
CACHE_TTL_SECONDS=3600

